{
  "version": 5,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "android-arm64",
      "displayName": "Android ARM64 (Android NDK from ANDROID_NDK_HOME)",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-30", "ANDROID_STL": "c++_static", "ARTB_TARGET": "android_arm64" }
    }
  ],
  "buildPresets": [
    { "name": "android-arm64", "configurePreset": "android-arm64", "targets": ["artb"] }
  ]
}
