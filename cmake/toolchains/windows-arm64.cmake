# Cross-compiles for Windows on ARM64 with llvm-mingw; ARTB_LLVM_MINGW overrides the newest toolchain unpacked under toolchains/ at the repository root.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(DEFINED ENV{ARTB_LLVM_MINGW})
    # Backslashes from a Windows path would be written unescaped into CMake's generated compiler files.
    file(TO_CMAKE_PATH "$ENV{ARTB_LLVM_MINGW}" ARTB_LLVM_MINGW)
else()
    file(GLOB ARTB_LLVM_MINGW_DIRS LIST_DIRECTORIES true "${CMAKE_CURRENT_LIST_DIR}/../../toolchains/llvm-mingw-*")
    list(SORT ARTB_LLVM_MINGW_DIRS)
    list(POP_BACK ARTB_LLVM_MINGW_DIRS ARTB_LLVM_MINGW)
endif()
if(NOT ARTB_LLVM_MINGW OR NOT IS_DIRECTORY "${ARTB_LLVM_MINGW}/aarch64-w64-mingw32")
    message(FATAL_ERROR "llvm-mingw not found; unpack it under toolchains/ or set ARTB_LLVM_MINGW")
endif()
if(CMAKE_HOST_WIN32)
    set(ARTB_LLVM_MINGW_SUFFIX .exe)
endif()
set(CMAKE_C_COMPILER "${ARTB_LLVM_MINGW}/bin/aarch64-w64-mingw32-clang${ARTB_LLVM_MINGW_SUFFIX}")
set(CMAKE_CXX_COMPILER "${ARTB_LLVM_MINGW}/bin/aarch64-w64-mingw32-clang++${ARTB_LLVM_MINGW_SUFFIX}")
set(CMAKE_RC_COMPILER "${ARTB_LLVM_MINGW}/bin/aarch64-w64-mingw32-windres${ARTB_LLVM_MINGW_SUFFIX}")
# Only the target sysroot may satisfy library lookups, so host MSYS2 x64 libraries on PATH are never picked up.
set(CMAKE_FIND_ROOT_PATH "${ARTB_LLVM_MINGW}/aarch64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
